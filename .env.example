# ─── Database (Supabase PostgreSQL) ───
# Pooled connection for app runtime (Transaction pooler, port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection for Prisma migrations (Session pooler or direct, port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ─── Razorpay ───
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
# Webhook secret from Razorpay Dashboard → Webhooks (required for production)
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# ─── Resend (Email) ───
RESEND_API_KEY="re_xxxxxxxx"
RESEND_FROM_EMAIL="Panchayat <orders@yourdomain.com>"
ADMIN_NOTIFICATION_EMAIL="admin@yourdomain.com"
# For MVP: sends order confirmation to this email (include customer phone in body)
CUSTOMER_NOTIFICATION_EMAIL="notifications@yourdomain.com"

# ─── Admin ───
ADMIN_PASSWORD="change-this-strong-password"

# ─── Panchayat branding (public) — Hiramandalam defaults in src/lib/content.ts ───
NEXT_PUBLIC_PANCHAYAT_NAME="Hiramandalam Major Panchayat"
NEXT_PUBLIC_PANCHAYAT_NAME_TE="హిరమండలం మేజర్ పంచాయతీ"
NEXT_PUBLIC_CONTACT_PHONE="9573288939"
NEXT_PUBLIC_CONTACT_EMAIL="hiramandalam.panchayat@example.com"
NEXT_PUBLIC_CONTACT_ADDRESS="Vermicompost Sales Center - SWPC SHED, Hiramandalam"

# ─── WhatsApp (optional stub — wire Meta/Twilio API in production) ───
ADMIN_WHATSAPP_NUMBER="+919876543210"
